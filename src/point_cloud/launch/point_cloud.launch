<launch>
  <!-- 发布深度相机相对于 INS 的静态 TF -->
  <node pkg="tf" type="static_transform_publisher" name="depth_to_ins"
        args="0.82 0 0.56 0 0 0 OurCar/INS depth_camera_link 100" />

  <!-- 启动你的点云节点 -->
  <node pkg="point_cloud" type="point_cloud_node.py" name="point_cloud_node" output="screen"/>
</launch>