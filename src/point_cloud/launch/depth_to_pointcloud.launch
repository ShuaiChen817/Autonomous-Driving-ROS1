<launch>
  <!-- 发布 TF -->
  <node pkg="tf" type="static_transform_publisher" name="depth_to_ins"
        args="0.82 0 0.56 0 0 0 OurCar/INS OurCar/Sensors/DepthCamera 100" />

  <!-- nodelet manager -->
  <node pkg="nodelet" type="nodelet" name="depth_proc_manager" args="manager" output="screen" />

  <!-- 加载 depth_image_proc 的功能块 -->
  <node pkg="nodelet" type="nodelet" name="depth_to_cloud"
        args="load depth_image_proc/point_cloud_xyz depth_proc_manager" output="screen">
    <remap from="image_rect" to="/Unity_ROS_message_Rx/OurCar/Sensors/DepthCamera/image_raw"/>
    <remap from="camera_info" to="/Unity_ROS_message_Rx/OurCar/Sensors/DepthCamera/camera_info"/>
  </node>
</launch>

