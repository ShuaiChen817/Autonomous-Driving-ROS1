<launch>
    <node name="traffic_light_detector"
          pkg="traffic_light_detector"
          type="traffic_light_detector_node.py"
          output="screen">
        
        <param name="model_path" value="/home/hao/YoloV5/yolov5/yolov5s.pt"/>
        <param name="confidence" value="0.4"/>
        <param name="camera_topic" value="/Unity_ROS_message_Rx/OurCar/Sensors/RGBCameraLeft/image_raw"/>
    </node>
</launch>
