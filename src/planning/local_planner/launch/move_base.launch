<launch>
  <!-- 启动 move_base 节点 -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">

    <!-- 加载主参数 -->
    <rosparam file="$(find local_planner)/params/move_base_params.yaml" command="load" />

    <!-- 公共 costmap 参数（obstacle_layer, inflation_layer 等） -->
    <rosparam file="$(find local_planner)/params/costmap_common_params.yaml" command="load" />

    <!-- global_costmap 独立配置 -->
    <rosparam file="$(find local_planner)/params/global_costmap_params.yaml" command="load" ns="global_costmap" />

    <!-- local_costmap 独立配置 -->
    <rosparam file="$(find local_planner)/params/local_costmap_params.yaml" command="load" ns="local_costmap" />

    <!-- 可选：static_map 参数（如果你用了 static layer） -->
    <rosparam file="$(find local_planner)/params/static_map_params.yaml" command="load" />

  </node>

  <!-- 可选：开启 RViz -->
  <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find local_planner)/rviz/move_base.rviz" required="false" /> -->
</launch>
